# Disable caching for index.html so browsers always fetch the latest JS bundle hash
<IfModule mod_headers.c>
  <FilesMatch "index\.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Single Page Application (SPA) Routing for Hostinger
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exclude missing static assets from SPA rewrite to avoid returning index.html as JS/CSS
  RewriteRule ^assets/ - [L,R=404]

  # Rewrite all other paths to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>
